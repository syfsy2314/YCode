# YCode 本地配置（可能包含 API Key）
.ycode/config.yaml
.ycode/context/

# 本地环境变量文件；示例文件允许提交
.env
.env.*
!.env.example

# Python 虚拟环境
.venv/
venv/
env/
ENV/

# Python 字节码和解释器缓存
__pycache__/
*.py[cod]
*$py.class

# 测试、覆盖率和静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python 打包和构建产物
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 编辑器和 IDE 的本地配置
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 本地日志和临时文件
*.log
*.tmp
*.temp
